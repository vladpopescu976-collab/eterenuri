// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PERSONAL
  BUSINESS
}

enum SportType {
  FOOTBALL
  BASKETBALL
  TENNIS
  VOLLEYBALL
  HANDBALL
  PADEL
  BADMINTON
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  RESCHEDULE_PROPOSED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(PERSONAL)
  phone         String?
  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  fields   Field[]   @relation("OwnerFields")
  bookings Booking[] @relation("CustomerBookings")

  favorites Favorite[] @relation("UserFavorites")
  reviews   Review[]   @relation("UserReviews")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Field {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  sportType   SportType
  city        String
  address     String
  pricePerHour Decimal  @db.Decimal(10, 2)
  images      String[]
  amenities   String[]
  isActive    Boolean   @default(true)
  contactPhone String?

  openingHour Int @default(8)
  closingHour Int @default(23)

  ownerId String
  owner   User   @relation("OwnerFields", fields: [ownerId], references: [id], onDelete: Cascade)

  bookings     Booking[]
  favorites    Favorite[]
  reviews      Review[]
  blockedSlots BlockedSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([sportType])
  @@index([ownerId])
  @@map("fields")
}

model Booking {
  id     String        @id @default(cuid())
  status BookingStatus @default(PENDING)

  startTime DateTime
  endTime   DateTime

  // Proposed reschedule time (set by BUSINESS owner)
  proposedStartTime DateTime?
  proposedEndTime   DateTime?
  rescheduleNote    String?   @db.Text

  totalPrice Decimal @db.Decimal(10, 2)
  notes      String? @db.Text

  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  customerId String
  customer   User   @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)

  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fieldId])
  @@index([customerId])
  @@index([status])
  @@map("bookings")
}

// Terenuri salvate de jucători.
model Favorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)

  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, fieldId])
  @@index([userId])
  @@map("favorites")
}

// O recenzie e legată de o rezervare încheiată, ca să nu poată scrie
// oricine despre un teren pe care nu a jucat.
model Review {
  id      String  @id @default(cuid())
  rating  Int
  comment String? @db.Text

  ownerReply   String?   @db.Text
  ownerReplyAt DateTime?

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("UserReviews", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fieldId])
  @@index([authorId])
  @@map("reviews")
}

// Ore blocate manual de proprietar: mentenanță, rezervări primite la telefon,
// evenimente private. Ocupă terenul exact ca o rezervare.
model BlockedSlot {
  id String @id @default(cuid())

  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  startTime DateTime
  endTime   DateTime
  reason    String?

  // O rezervare primită la telefon ocupă terenul exact ca o blocare, doar că
  // are un client. Cu numele completat, intervalul e o rezervare manuală;
  // fără el, e o blocare (mentenanță, eveniment propriu).
  clientName  String?
  clientPhone String?

  createdAt DateTime @default(now())

  @@index([fieldId])
  @@map("blocked_slots")
}
